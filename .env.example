# Токен бота от @BotFather
BOT_TOKEN=
# Произвольный секрет для проверки webhook Telegram (обязателен в проде)
BOT_WEBHOOK_SECRET=
# Публичный URL webhook, например https://example.com/bot/webhook
BOT_WEBHOOK_URL=
# База данных (по умолчанию SQLite рядом с проектом)
DATABASE_URL=sqlite:///./agrowork.db
# ENV=prod — отключает /docs, /redoc и /openapi.json
ENV=
